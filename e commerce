<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My E-Commerce Store</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
}

header{
    background:#0077cc;
    color:white;
    padding:20px;
    text-align:center;
}

nav{
    background:#222;
    text-align:center;
    padding:10px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:15px;
    font-weight:bold;
}

nav a:hover{
    color:yellow;
}

.banner{
    background:#4CAF50;
    color:white;
    text-align:center;
    padding:40px;
}

.products{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    padding:20px;
    gap:20px;
}

.card{
    background:white;
    width:250px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,0.2);
    text-align:center;
    padding:15px;
}

.card img{
    width:100%;
    height:180px;
    object-fit:cover;
    border-radius:8px;
}

.card h3{
    margin:10px 0;
}

.price{
    color:green;
    font-size:22px;
    font-weight:bold;
}

button{
    background:#0077cc;
    color:white;
    border:none;
    padding:10px 20px;
    margin-top:10px;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:#005fa3;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}
</style>

</head>
<body>

<header>
    <h1>My Online Shop</h1>
    <p>Best Deals Every Day</p>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Products</a>
    <a href="#">Cart</a>
    <a href="#">Contact</a>
</nav>

<section class="banner">
    <h2>Welcome to Our Store</h2>
    <p>Shop the Latest Products at Great Prices!</p>
</section>

<section class="products">

<div class="card">
    <img src="https://via.placeholder.com/250x180" alt="Laptop">
    <h3>Laptop</h3>
    <p class="price">₹45,000</p>
    <button>Add to Cart</button>
</div>

<div class="card">
    <img src="https://via.placeholder.com/250x180" alt="Phone">
    <h3>Smart Phone</h3>
    <p class="price">₹20,000</p>
    <button>Add to Cart</button>
</div>

<div class="card">
    <img src="https://via.placeholder.com/250x180" alt="Headphones">
    <h3>Headphones</h3>
    <p class="price">₹2,000</p>
    <button>Add to Cart</button>
</div>

<div class="card">
    <img src="https://via.placeholder.com/250x180" alt="Watch">
    <h3>Smart Watch</h3>
    <p class="price">₹3,500</p>
    <button>Add to Cart</button>
</div>

</section>

<footer>
    <p>&copy; 2026 My Online Shop. All Rights Reserved.</p>
</footer>

</body>
</html>
